{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"rootDir": ".",
		"outDir": "dist",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"inlineSources": true,
		"rewriteRelativeImportExtensions": true,
		"removeComments": false
	},
	"include": ["maestro/**/*.ts", "pi-extension/**/*.ts"],
	"exclude": ["node_modules", "dist", "test", "scripts", "tools"]
}
